{
    "compilerOptions": {
        "target": "ES2022",
        "module": "Node16",
        "moduleResolution": "Node16",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "@pages/*": [
                "./src/pages/*"
            ],
            "@utils/*": [
                "./src/utils/*"
            ],
            "@config/*": [
                "./src/config/*"
            ],
            "@fixtures/*": [
                "./src/fixtures/*"
            ]
        }
    },
    "include": [
        "src/**/*",
        "tests/**/*",
        "playwright.config.ts"
    ]
}
